# --- Frontend (Vite) ---
# Estas dos son públicas por diseño: la seguridad la da RLS en Supabase, no el secreto de la clave.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# --- Solo para Netlify Functions (NUNCA van al frontend) ---
# Configurar estas en el dashboard de Netlify (Site settings > Environment variables),
# no en un archivo .env que se suba al repo.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_SECRET_KEY
ADMIN_PASSWORD=elegi-una-contraseña-simple
